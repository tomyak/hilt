# HILT Backend Environment Variables

# Security - JWT
SECRET_KEY=your-secret-key-here-min-32-characters-long-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# API Keys for LLM clients (comma-separated)
# Generate strong keys for production
HILT_API_KEYS=hilt_sk_test123,hilt_sk_dev456

# Initial operator credentials
OPERATOR_USERNAME=admin
# IMPORTANT: Generate a secure password hash for production!
# Generate new hash with: python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
OPERATOR_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# Request timeout (seconds)
REQUEST_TIMEOUT_SECONDS=300

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Maximum request body size (in bytes, default 10MB)
MAX_REQUEST_SIZE=10485760
